# tekRESCUE Mechanic for OpenClaw configuration.
# Copy this file to ~/.config/tekrescue-mechanic/.env and chmod 600.
# Lines starting with # are comments. Empty lines are ignored.

# ===== Required =====

# Absolute path to the openclaw executable.
# Find yours with: which openclaw
OPENCLAW_BIN_PATH=

# Absolute path to OpenClaw's config directory.
# Mechanic snapshots this directory before every update.
OPENCLAW_CONFIG_PATH=

# ===== Optional =====

# Time of day (24h, local) when the nightly update routine runs.
# Default: 02:00
UPDATE_TIME=02:00

# Release waiting period, in days. Mechanic never installs an OpenClaw
# release until it has been public on the npm registry for at least this
# long. OpenClaw ships every two or three days from a repo with hundreds of
# contributors; a poisoned release usually gets caught and pulled within
# days, and this keeps you from being the one who installed it first.
# Because the newest release is rarely a week old, Mechanic installs the
# newest one that IS old enough (via `openclaw update --tag <version>`) and
# trails the release train by this many days. The morning report and the
# heartbeat always say which version was picked and why. Needs npm next to
# openclaw or on PATH (it reads publish dates with `npm view openclaw`);
# without it, updates wait and the report tells you.
# 0 turns the wait off and installs whatever `openclaw update` picks.
# Default: 7
MIN_UPDATE_AGE_DAYS=7

# How often the supervisor heartbeat fires, in minutes. Each tick: health
# check + update-available probe + a notifier ping with the result. The
# absence of a heartbeat ping is informative on its own (means the
# supervisor itself stopped firing), so prefer a cadence that produces a
# manageable number of pings per day.
# Default: 240 (every 4 hours, 6 pings per day)
SUPERVISOR_INTERVAL_MINUTES=240

# What to do when openclaw doctor --fix asks a prompt Mechanic does not recognize.
# Dormant in v0.1.1: Mechanic runs doctor with --non-interactive, which is
# OpenClaw's "no prompts, safe migrations only" mode, so PROMPT_MODE is not
# consulted by the nightly path. Reserved for v0.2 if/when we drop
# --non-interactive to access the broader fix set.
#   STRICT    : (v0.2) abort the doctor run on an unrecognised prompt. Safest.
#   ESCALATE  : (v0.2) forward the prompt to your notifier; otherwise abort.
#   AUTO_YES  : (v0.2) answer "y" to everything. Reckless, not recommended.
PROMPT_MODE=STRICT

# How many days of snapshots to keep in snapshots/nightly/ before pruning.
# Sticky snapshots (first-known-good, last-known-good) are never pruned.
# Default: 14
SNAPSHOT_RETENTION_DAYS=14

# Free disk floor (in megabytes) for a nightly run. Mechanic estimates the
# space the run actually needs (about two snapshot archives) and, if the
# snapshot volume is short, deletes its own OLDEST nightly snapshots to make
# room. First-known-good and last-known-good are never touched, and the 3
# newest nightlies always survive. Only if pruning cannot free enough does
# the updater refuse to start. We never proceed with an update if a rollback
# would not fit.
# Default: 500
MIN_FREE_DISK_MB_FOR_SNAPSHOT=500

# Number of consecutive failed nightly runs before Mechanic auto-pauses.
# Run `mechanic resume` to clear the pause.
# Default: 3
MAX_CONSECUTIVE_FAILURES=3

# If a rollback itself fails, enter paused mode immediately regardless of
# the consecutive-failures count.
# Default: true
PAUSE_ON_ROLLBACK_FAILURE=true

# Optional: path to an executable that re-applies your local OpenClaw
# patches after a real update. The nightly only runs `openclaw update`
# when the registry actually has a newer version than the installed one
# (a same-version reinstall replaces every installed file and wipes local
# patches for nothing). Whenever an update DOES modify the install, this
# hook runs afterwards, before the post-update verify, so your approved
# patches survive the new files. Leave empty if you patch nothing.
# The hook runs with a clean environment; its exit code and output land
# in the morning report. A failing hook is reported loudly but does not
# fail the run.
# POST_UPDATE_HOOK=

# Seconds the hook may run before Mechanic gives up on it.
# Default: 300
# POST_UPDATE_HOOK_TIMEOUT_SECONDS=300

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default: INFO
LOG_LEVEL=INFO

# ===== Notifications (all optional) =====

# Which notifier to use for morning reports and alerts.
#   none      : everything stays in local logs. (default)
#   telegram  : requires TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
#   slack     : requires SLACK_WEBHOOK_URL.
#   webhook   : requires WEBHOOK_URL.
#   email     : requires SMTP_HOST, SMTP_FROM, SMTP_TO (and credentials).
NOTIFIER=none

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Slack
# SLACK_WEBHOOK_URL=

# Generic webhook (POSTs JSON)
# WEBHOOK_URL=

# Email (SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
